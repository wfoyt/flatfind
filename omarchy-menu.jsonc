{
  "install.flatpak": {
    "icon": "󰏓",
    "label": "Flatpak",
    "when": "[[ -x \"$HOME/.config/omarchy/plugins/wfoyt.flatpak-companion/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfoyt.flatpak-companion\" and .enabled == true)' >/dev/null",
    "action": "[[ -x \"$HOME/.config/omarchy/plugins/wfoyt.flatpak-companion/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfoyt.flatpak-companion\" and .enabled == true)' >/dev/null && xdg-terminal-exec --app-id=org.omarchy.terminal \"$HOME/.config/omarchy/plugins/wfoyt.flatpak-companion/flatpak-companion\""
  },
  "remove.flatpak": {
    "icon": "󰏓",
    "label": "Flatpak",
    "when": "[[ -x \"$HOME/.config/omarchy/plugins/wfoyt.flatpak-companion/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfoyt.flatpak-companion\" and .enabled == true)' >/dev/null",
    "action": "[[ -x \"$HOME/.config/omarchy/plugins/wfoyt.flatpak-companion/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfoyt.flatpak-companion\" and .enabled == true)' >/dev/null && xdg-terminal-exec --app-id=org.omarchy.terminal \"$HOME/.config/omarchy/plugins/wfoyt.flatpak-companion/flatpak-companion\" remove"
  }
}
