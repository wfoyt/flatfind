{
  "install.flatpak": {
    "icon": "󰏓",
    "label": "Flatpak",
    "after": "install.package",
    "when": "[[ -x \"$HOME/.config/omarchy/plugins/wfo.flatfind/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfo.flatfind\" and .enabled == true)' >/dev/null",
    "action": "[[ -x \"$HOME/.config/omarchy/plugins/wfo.flatfind/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfo.flatfind\" and .enabled == true)' >/dev/null && xdg-terminal-exec --app-id=org.omarchy.terminal \"$HOME/.config/omarchy/plugins/wfo.flatfind/flatpak-companion\""
  },
  "remove.flatpak": {
    "icon": "󰏓",
    "label": "Flatpak",
    "after": "remove.package",
    "when": "[[ -x \"$HOME/.config/omarchy/plugins/wfo.flatfind/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfo.flatfind\" and .enabled == true)' >/dev/null",
    "action": "[[ -x \"$HOME/.config/omarchy/plugins/wfo.flatfind/flatpak-companion\" ]] && omarchy plugin list --json | jq -e 'any(.[]; .id == \"wfo.flatfind\" and .enabled == true)' >/dev/null && xdg-terminal-exec --app-id=org.omarchy.terminal \"$HOME/.config/omarchy/plugins/wfo.flatfind/flatpak-companion\" remove"
  }
}
