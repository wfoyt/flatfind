#!/usr/bin/env bash
set -euo pipefail

source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
plugins_dir="$HOME/.config/omarchy/plugins"
target="$plugins_dir/wfo.flatfind"

if [[ -e $target || -L $target ]]; then
    if [[ $source_dir == "$(realpath -e -- "$target")" ]]; then
        exec python3 "$target/omarchy/desktop.py" --install-cli
    fi
    printf 'Already installed at %s. Run its install script to restore the CLI link.\n' "$target" >&2
    exit 1
fi

omarchy plugin validate "$source_dir"
cli="$HOME/.local/bin/flatpak-companion"
if [[ -e $cli || -L $cli ]] && [[ $(readlink -- "$cli") != "$target/flatpak-companion" ]]; then
    printf 'A different command already exists at %s.\n' "$cli" >&2
    exit 1
fi

mkdir -p -- "$plugins_dir"
stage=$(mktemp -d -- "$plugins_dir/.flatpak-companion.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
cp -a -- "$source_dir"/{install,manifest.json,Service.qml,flatpak-companion,flatfind,omarchy,omarchy-menu.jsonc} "$stage/"
if ! mv -T --no-clobber -- "$stage" "$target" || [[ -d $stage ]]; then
    printf 'Flatpak Companion is already installed at %s. Enable it with omarchy plugin enable wfo.flatfind.\n' "$target" >&2
    exit 1
fi

exec python3 "$target/omarchy/desktop.py" --install-cli
